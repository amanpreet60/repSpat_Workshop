Package: repSpatWorkshop
Title: Detecting Repeated Spatial Patterns With repSpat
Version: 0.0.1
Authors@R: c(
    person(given = "Amanpreet", family = "Singh", role = c("aut", "cre"), email = "singa429@mcmaster.ca"),
